# Apache Configuration for Vehicle Details & Insurance Renewal System
<IfModule mod_dir.c>
    DirectoryIndex index.php index.html
</IfModule>

# UTF-8 Encoding
AddDefaultCharset UTF-8

# Protect Sensitive Files
<FilesMatch "^\.(htaccess|htpasswd|ini|env|log)$">
    <IfModule authz_core_module>
        Require all denied
    </IfModule>
    <IfModule !authz_core_module>
        Deny from all
    </IfModule>
</FilesMatch>

