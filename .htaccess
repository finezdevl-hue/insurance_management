# Apache Configuration for Vehicle Details & Insurance Renewal System
<IfModule mod_dir.c>
    DirectoryIndex index.php index.html
</IfModule>

# UTF-8 Encoding
AddDefaultCharset UTF-8

# Protect Sensitive Files
<FilesMatch "^\.(htaccess|htpasswd|ini|env|log)$">
    <IfModule authz_core_module>
        Require all denied
    </IfModule>
    <IfModule !authz_core_module>
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent Cloudways Varnish / Nginx / Proxies from caching dynamic PHP scripts & sessions
<IfModule mod_headers.c>
    <FilesMatch "\.(php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, private"
        Header set Pragma "no-cache"
        Header set Expires "Sat, 26 Jul 1997 05:00:00 GMT"
    </FilesMatch>
</IfModule>


